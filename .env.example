# Fritzbox-Zugangsdaten (Asterisk und TR-064), Google-Gemini-Schluessel und Aufbewahrung der Anrufe stellt der
# Administrator nach dem ersten Start in der Weboberflaeche ein (Einstellungen). Sie stehen nicht in dieser Datei.
# Wer sie trotzdem hier eintraegt (FRITZ_HOST, FRITZ_USER, FRITZ_PASSWORD, FRITZ_TR064_USER, FRITZ_TR064_PASSWORD,
# GEMINI_API_KEY, RETENTION_DAYS), nutzt sie als Voreinstellung; Werte aus der Oberflaeche haben Vorrang.
#
# Kommentare immer in eine eigene Zeile schreiben, nie hinter einen Wert: Docker Compose und podman-compose lesen
# "UI_PASSWORD=   # Text" sonst als Passwort "# Text".

# ---- Webinterface ----------------------------------------------------------------------------
# Passwort des ersten Administrators "admin" (danach in der Oberflaeche aenderbar). Pflicht vor dem ersten Start.
UI_PASSWORD=
WEB_PORT=8080
# HTTP-Basic-Anmeldung (admin + UI_PASSWORD, fuer Skripte) erlauben; Standard: aus
# ALLOW_BASIC=1

# ---- Modell --------------------------------------------------------------------------------------
# Standardmodell fuer Agenten mit "Standard"; pro Agent aenderbar
GEMINI_MODEL=gemini-3.8-live

# ---- E-Mail-Benachrichtigungen (Server/Benutzer in der Oberflaeche unter "Benachrichtigungen") -
# Alles laesst sich in der Oberflaeche einstellen (auch das Passwort). Alternativ per .env (die Oberflaeche hat Vorrang),
# je Wert eine Zeile, z. B.:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=...

# ---- Optional --------------------------------------------------------------------------------
# wird von asterisk/render.sh erzeugt (und hier angehaengt), wenn leer
# AMI_SECRET=
# Notschalter: SIP-Anfragen nicht nur von der Fritzbox-IP annehmen (Standard 1 = nur Fritzbox)
# SIP_ACL=0
# harte Hoechstdauer eines Gespraechs (Sekunden)
# MAX_CALL_SECONDS=1800
# gesperrte Rufnummern-Praefixe (nie waehlen)
# DIAL_BLOCK=0900,0137,0180,0190,118,00
# Abstand der Live-Mitschrift bei vermittelten Gespraechen (Sekunden)
# LIVE_INTERVAL=10
# Ordner fuer eigene Plugins
# PLUGIN_DIR=/data/plugins
